# Cloudflare Pages response headers. Not applied to Pages Function responses
# (functions/api/contact.js sets its own).
#
# The CSP is deliberately Report-Only for now. It was verified against every route in
# headless Chrome with zero violations, but watch the browser console on the live site
# for a week, then rename the header to Content-Security-Policy. Expected noise while
# Bot Fight Mode is on: Cloudflare's own inline bot-detection snippet.
# style-src needs 'unsafe-inline' because react-type-animation injects a <style> element.
# The 'sha256-Pi5sjuXquUWfdQfRCOw/PSYj/daitMiZM6ii4shWqRA=' in script-src is the theme bootstrap script in index.html; if that
# script changes, recompute:  node scripts/csp-hash.mjs

/*
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' 'sha256-Pi5sjuXquUWfdQfRCOw/PSYj/daitMiZM6ii4shWqRA=' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; media-src 'self' https://media.alexandrudabu.com; connect-src 'self'; frame-src https://www.youtube-nocookie.com https://www.youtube.com https://challenges.cloudflare.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Referrer-Policy: strict-origin-when-cross-origin
  X-Content-Type-Options: nosniff

# Hashed build output: safe to cache forever. index.html keeps Pages' default
# "max-age=0, must-revalidate" so a new deploy is picked up on the next load.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Keep the CV downloadable but out of search results (it contains the phone number).
/AlexandruDabu-CV.pdf
  X-Robots-Tag: noindex
